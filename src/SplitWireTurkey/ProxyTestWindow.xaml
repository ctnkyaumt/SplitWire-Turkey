<Window x:Class="SplitWireTurkey.ProxyTestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="ByeDPI Proxy Testi"
        Height="700" Width="760"
        MinHeight="500" MinWidth="620"
        WindowStartupLocation="CenterOwner"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        FontFamily="{StaticResource PoppinsRegular}"
        Background="White">

    <Window.Resources>
        <Style x:Key="SettingLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="FontFamily" Value="{StaticResource PoppinsRegular}"/>
        </Style>
        <Style x:Key="SettingBox" TargetType="TextBox">
            <Setter Property="Width" Value="70"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,20,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Başlık -->
        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock x:Name="txtTitle"
                       Text="ByeDPI Proxy Testi"
                       FontFamily="{StaticResource PoppinsBold}"
                       FontSize="18"
                       HorizontalAlignment="Center"/>
            <TextBlock x:Name="txtDisclaimer"
                       Text="Her strateji ayrı bir yerel SOCKS5 proxy üzerinde denenir. Test sırasında internet trafiğiniz etkilenmez."
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       FontSize="11"
                       Opacity="0.75"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Ayarlar -->
        <Expander Grid.Row="1" x:Name="expSettings" Header="Test Ayarları" Margin="0,0,0,8">
            <StackPanel Margin="12,10,12,10">
                <WrapPanel>
                    <TextBlock x:Name="lblDelay" Text="Gecikme (x0.5 sn):" Style="{StaticResource SettingLabel}"/>
                    <TextBox x:Name="txtDelay" Style="{StaticResource SettingBox}"/>

                    <TextBlock x:Name="lblRequests" Text="Site başına istek:" Style="{StaticResource SettingLabel}"/>
                    <TextBox x:Name="txtRequests" Style="{StaticResource SettingBox}"/>

                    <TextBlock x:Name="lblConcurrency" Text="Eş zamanlı istek:" Style="{StaticResource SettingLabel}"/>
                    <TextBox x:Name="txtConcurrency" Style="{StaticResource SettingBox}"/>
                </WrapPanel>

                <WrapPanel Margin="0,10,0,0">
                    <TextBlock x:Name="lblTimeout" Text="Zaman aşımı (sn):" Style="{StaticResource SettingLabel}"/>
                    <TextBox x:Name="txtTimeout" Style="{StaticResource SettingBox}"/>

                    <TextBlock x:Name="lblSni" Text="SNI:" Style="{StaticResource SettingLabel}"/>
                    <TextBox x:Name="txtSni" Width="150" VerticalAlignment="Center" Margin="0,0,20,0"/>

                    <TextBlock x:Name="lblPort" Text="Test portu:" Style="{StaticResource SettingLabel}"/>
                    <TextBox x:Name="txtPort" Style="{StaticResource SettingBox}"/>
                </WrapPanel>

                <TextBlock x:Name="lblSiteLists" Text="Site listeleri:" Margin="0,14,0,6" FontFamily="{StaticResource PoppinsBold}"/>
                <ItemsControl x:Name="itemsSiteLists">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <CheckBox x:Name="chkCustomStrategies"
                              Checked="ChkCustomStrategies_Changed"
                              Unchecked="ChkCustomStrategies_Changed"/>
                    <TextBlock x:Name="lblCustomStrategies" Text="Kendi strateji listemi kullan" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <TextBox x:Name="txtCustomStrategies"
                         Height="110"
                         Margin="0,8,0,0"
                         AcceptsReturn="True"
                         TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         IsEnabled="False"/>
            </StackPanel>
        </Expander>

        <!-- İlerleme -->
        <TextBlock Grid.Row="2"
                   x:Name="txtProgress"
                   Text=""
                   HorizontalAlignment="Center"
                   Margin="0,0,0,8"
                   FontFamily="{StaticResource PoppinsBold}"/>

        <!-- Sonuçlar -->
        <Border Grid.Row="3" BorderBrush="#40808080" BorderThickness="1" CornerRadius="4">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="itemsResults" Margin="4">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Expander Margin="2">
                                <Expander.Header>
                                    <Grid Width="620">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Command}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"
                                                   FontSize="12"
                                                   ToolTip="{Binding Command}"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding ProgressText}"
                                                   VerticalAlignment="Center"
                                                   Margin="10,0,10,0"
                                                   FontFamily="{StaticResource PoppinsBold}"
                                                   FontSize="12"/>
                                        <Button Grid.Column="2"
                                                Content="Uygula"
                                                Padding="8,0"
                                                Height="24"
                                                FontSize="11"
                                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                                Click="BtnApplyStrategy_Click"
                                                Tag="{Binding Command}"/>
                                    </Grid>
                                </Expander.Header>
                                <ItemsControl ItemsSource="{Binding SiteResults}" Margin="26,4,4,8">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Display}" FontSize="11" Opacity="0.85"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Butonlar -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
            <Button x:Name="btnStartStop"
                    Content="Testi Başlat"
                    Width="150"
                    Height="36"
                    FontFamily="{StaticResource PoppinsBold}"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Click="BtnStartStop_Click"/>
            <Button x:Name="btnCopyLog"
                    Content="Günlüğü Kopyala"
                    Width="150"
                    Height="36"
                    Margin="10,0,0,0"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Click="BtnCopyLog_Click"/>
            <Button x:Name="btnClose"
                    Content="Kapat"
                    Width="110"
                    Height="36"
                    Margin="10,0,0,0"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Click="BtnClose_Click"/>
        </StackPanel>
    </Grid>
</Window>
